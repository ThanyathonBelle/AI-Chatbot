# Copy to .env. Restart after changing provider keys / endpoints.
APP_PORT=8080
# If hosting on a LAN/Internet, set a strong password and use HTTPS reverse proxy.
APP_USERNAME=admin
APP_PASSWORD=

# Local Ollama: Windows/Mac Docker -> host.docker.internal; Docker on Linux -> host-gateway.
# Kubernetes NodePort example: http://<KUBE_NODE_IP>:31434 (only if your Ollama exposes that port)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODELS=qwen3:8b,llama3.2:3b

# Local vLLM / LM Studio OpenAI-compatible endpoint. Add /v1 at the end.
# Example: http://host.docker.internal:8000/v1
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODELS=Qwen/Qwen3-8B

# Public AI providers. Leave empty to disable provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4.1-mini,gpt-5-mini

GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-3.8-flash

OPENROUTER_API_KEY=
OPENROUTER_MODELS=openai/gpt-4.1-mini,google/gemini-2.5-flash
